def default_task_dir(as_root):
    """As root the table sits outside the pm-owned /var/lib/pm-sbx (pm could swap anything in it for a link); the parent
    /var/lib is root's. As pm (today: pm-sbx-start-desktop starts this daemon as pm) there is no one to protect from, and
    /var/lib/pm-sbx is the pm-owned folder the installer makes (its parent /var/lib is root's). Either way TaskManager checks
    the folder (owner = this process, 0700, no link, parents root's or ours and not writable by others) before every use."""
    return "/var/lib/pm-sbx-tasks" if as_root else "/var/lib/pm-sbx/tasks"


DEFAULT_TASK_DIR = default_task_dir(RUNS_AS_ROOT)

DISPLAY_LOCKS = {}
DISPLAY_LOCKS_GUARD = threading.Lock()


def _load_sibling(module_name, filename):
    """Load a guest file that sits next to this one by path (the name has dashes, so no import statement)."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), filename)
    loader = importlib.machinery.SourceFileLoader(module_name, path)
    spec = importlib.util.spec_from_loader(module_name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


mcp_hub = _load_sibling("pm_sbx_mcp_hub", "pm-sbx-mcp-hub")


