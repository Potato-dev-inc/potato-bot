def display_lock(display):
    with DISPLAY_LOCKS_GUARD:
        lock = DISPLAY_LOCKS.get(display)
        if lock is None:
            lock = threading.Lock()
            DISPLAY_LOCKS[display] = lock
        return lock


def valid_display(display):
    return isinstance(display, str) and DISPLAY_RE.fullmatch(display) is not None


def read_token_file(path):
    if not path:
        raise ConfigError("PM_SBX_CONTROL_TOKEN_FILE is not set")
    try:
        with open(path, encoding="utf-8") as handle:
            token = handle.read().strip()
    except OSError as error:
        raise ConfigError(f"cannot read the control token file: {error.strerror or error}") from None
    if len(token) < MIN_TOKEN_LEN or any(ch.isspace() for ch in token):
        raise ConfigError("the control token file must hold one token of at least 16 non-space characters")
    try:
        if os.stat(path).st_mode & 0o077:
            print("pm-sbx-control: warning: the token file is readable by other users", file=sys.stderr)
    except OSError:
        pass
    return token


def authorized(header_value, token):
    """Constant-time check of an Authorization header against the token."""
    if not token or not isinstance(header_value, str) or not header_value.startswith("Bearer "):
        return False
    try:
        presented = header_value[len("Bearer "):].encode("utf-8")
    except UnicodeError:
        return False
    return hmac.compare_digest(presented, token.encode("utf-8"))


def parse_port(text):
    try:
        port = int(text)
    except (TypeError, ValueError):
        raise ConfigError("PM_SBX_CONTROL_PORT must be an integer") from None
    if not 1 <= port <= 65535:
        raise ConfigError("PM_SBX_CONTROL_PORT must be between 1 and 65535")
    return port


def _launcher_from_json(name, spec):
    if not LAUNCHER_NAME_RE.fullmatch(name):
        raise ConfigError(f"launcher name {name!r} is not a lowercase name")
    if not isinstance(spec, dict):
        raise ConfigError(f"launcher {name!r} must be an object")
    path = spec.get("path")
    # The guest is always POSIX: an absolute path starts with "/" on every host that runs the tests.
    if not isinstance(path, str) or not path.startswith("/") or "\0" in path or len(path) > 1024:
        raise ConfigError(f"launcher {name!r} needs an absolute path")
    default_class = path.rsplit("/", 1)[-1]
    wm_class = spec.get("wm_class", default_class)
    if not isinstance(wm_class, str) or not WM_CLASS_RE.fullmatch(wm_class):
        raise ConfigError(f"launcher {name!r} has an invalid wm_class")
    browser_profile = spec.get("browser_profile", False)
    if not isinstance(browser_profile, bool):
        raise ConfigError(f"launcher {name!r} browser_profile must be true or false")
    return Launcher(path, wm_class, browser_profile)


def load_launchers(path):
    """Launcher allowlist: built-in defaults, or the JSON file named by PM_SBX_LAUNCHERS_FILE.

    JSON form: {"launchers": {"chrome": {"path": "/usr/bin/google-chrome",
                                         "wm_class": "google-chrome", "browser_profile": true}}}
    """
    if not path:
        return dict(DEFAULT_LAUNCHERS)
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except OSError as error:
        raise ConfigError(f"cannot read the launcher file: {error.strerror or error}") from None
    except ValueError:
        raise ConfigError("the launcher file is not valid JSON") from None
    raw = data.get("launchers") if isinstance(data, dict) else None
    if not isinstance(raw, dict) or not raw:
        raise ConfigError("the launcher file needs a non-empty \"launchers\" object")
    return {name: _launcher_from_json(name, spec) for name, spec in raw.items()}


# ASCII digits only: str.isdigit() also accepts characters such as "²" that int() rejects.
ASCII_INT = re.compile(r"-?[0-9]+")
ASCII_COUNT = re.compile(r"[0-9]+")


def _is_int_string(value):
    return ASCII_INT.fullmatch(value) is not None


def _allowed_wheel(argv):
    """A wheel scroll: click --repeat N with the up (4), down (5), left (6) or right (7) button."""
    return (
        len(argv) == 4
        and argv[0] == "click"
        and argv[1] == "--repeat"
        and ASCII_COUNT.fullmatch(argv[2]) is not None
        and 1 <= int(argv[2]) <= 20
        and argv[3] in ("4", "5", "6", "7")
    )


def allowed_xdotool_argv(argv):
    """Only the xdotool forms the desktop actions emit (key, mousemove, mouseup, type, click)."""
    if len(argv) < 4 or argv[2] != "xdotool":
        return False
    op = argv[3]
    if op == "key":
        return len(argv) == 6 and argv[4] == "--clearmodifiers" and argv[5] != ""
    if op == "mousemove":
        if len(argv) == 7 and argv[4] == "--" and _is_int_string(argv[5]) and _is_int_string(argv[6]):
            return True
        if (
            len(argv) == 11
            and argv[4] == "--"
            and ASCII_INT.fullmatch(argv[5])
            and ASCII_INT.fullmatch(argv[6])
            and _allowed_wheel(argv[7:])
        ):
            return True
        return (
            len(argv) == 9
            and argv[4] == "--"
            and _is_int_string(argv[5])
            and _is_int_string(argv[6])
            and argv[7] in ("mousedown", "click")
            and argv[8] in ("1", "3")
        )
    if op == "mouseup":
        return len(argv) == 5 and argv[4] in ("1", "3")
    if op == "type":
        return len(argv) == 7 and argv[4] == "--clearmodifiers" and argv[5] == "--"
    if op == "click":
        return len(argv) == 7 and _allowed_wheel(argv[3:])
    return False


def control_command_index(argv):
    """Locate the executable after the optional supervisor-owned browser profile."""
    return 3 if len(argv) > 2 and isinstance(argv[2], str) and argv[2].startswith(PROFILE_PREFIX) else 2


def allowed_control_argv(argv, display, launchers):
    """Only supervisor-shaped argv for the locked display.

    Launch form: ["env", "DISPLAY=:N", ("PM_SBX_BROWSER_PROFILE=<path>",) "pm-sbx-focus-or-launch", NAME, ARG?]
    """
    if not isinstance(argv, list) or not (3 <= len(argv) <= MAX_ARGV):
        return False
    if any(not isinstance(value, str) or len(value) > MAX_ARG_LEN or "\0" in value for value in argv):
        return False
    if argv[0] != "env" or argv[1] != f"DISPLAY={display}":
        return False
    index = control_command_index(argv)
    if index >= len(argv):
        return False
    command = argv[index]
    if index == 3:
        profile = argv[2].removeprefix(PROFILE_PREFIX)
        if PROFILE_RE.fullmatch(profile) is None or command != FOCUS_OR_LAUNCH:
            return False
    if command == "xdotool":
        return allowed_xdotool_argv(argv)
    if command == FOCUS_OR_LAUNCH:
        if len(argv) not in (index + 2, index + 3):
            return False
        entry = launchers.get(argv[index + 1])
        if entry is None:
            return False
        if index == 3 and not entry.browser_profile:
            return False
        if len(argv) == index + 3 and (not argv[index + 2] or argv[index + 2].startswith("-")):
            return False
        return True
    return False


def build_launch_argv(argv, settings):
    """Translate a validated launch step into the focus wrapper's argv (no shell, no env prefix)."""
    index = control_command_index(argv)
    entry = settings.launchers[argv[index + 1]]
    profile = argv[2].removeprefix(PROFILE_PREFIX) if index == 3 else ""
    command = [sys.executable, "-I", settings.focus_wrapper, "--wm-class", entry.wm_class]
    if profile:
        command += ["--profile", profile]
    if entry.browser_profile:
        command += ["--wait", str(BROWSER_OPEN_POLL_SEC)]
    command += ["--", entry.path]
    if len(argv) == index + 3:
        command.append(argv[index + 2])
    return command


def child_env(display):
    env = dict(os.environ)
    env.pop("WAYLAND_DISPLAY", None)
    env.update(CHILD_ENV_PINS)
    env["DISPLAY"] = display
    return env


def run_control_argv(argv, display, settings):
    """Run one validated argv step. Called with the display lock held."""
    env = child_env(display)
    if argv[control_command_index(argv)] == FOCUS_OR_LAUNCH:
        command = build_launch_argv(argv, settings)
        timeout = FOCUS_COMPLETION_SEC
    else:
        command = argv
        timeout = CONTROL_TIMEOUT_SEC
    try:
        result = subprocess.run(
            command, env=env, timeout=timeout, stdin=subprocess.DEVNULL, capture_output=True
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError("computer action timed out") from error
    except OSError as error:
        raise RuntimeError("computer action failed") from error
    if result.returncode:
        raise RuntimeError("computer action failed")


def png_size(data):
    if len(data) < 24 or data[:8] != PNG_SIGNATURE or data[12:16] != b"IHDR":
        raise RuntimeError("screen capture failed")
    return int.from_bytes(data[16:20], "big"), int.from_bytes(data[20:24], "big")


def jpeg_from_png(png, quality):
    """One PNG frame re-encoded as JPEG at `quality`. None when convert is missing or fails."""
    try:
        result = subprocess.run(
            ["convert", "png:-", "-quality", str(quality), "jpeg:-"],
            input=png, capture_output=True, timeout=CAPTURE_TIMEOUT_SEC,
        )
    except (OSError, ValueError, subprocess.SubprocessError):
        return None
    if result.returncode or not result.stdout.startswith(JPEG_SOI):
        return None
    return result.stdout


def encode_picture(png):
    """(mime, bytes) for one frame: JPEG at the first quality step that fits IMAGE_BYTES_LIMIT.

    If the last step is still too big, that JPEG is returned anyway; the app then says the picture was too big
    (it never drops it silently). If convert fails, the PNG is returned as it was captured.
    """
    last = None
    for quality in JPEG_QUALITIES:
        jpeg = jpeg_from_png(png, quality)
        if jpeg is None:
            return "image/png", png
        last = jpeg
        if len(jpeg) <= IMAGE_BYTES_LIMIT:
            return "image/jpeg", jpeg
    return "image/jpeg", last


def capture(display):
    """One PNG frame of the root window plus cursor and active-window hints.

    Fallback capture only (no native helper): import(1) from ImageMagick. The
    result never carries a damage rectangle.
    """
    env = child_env(display)

    def query(argv):
        try:
            result = subprocess.run(
                argv, env=env, capture_output=True, text=True,
                stdin=subprocess.DEVNULL, timeout=CONTROL_TIMEOUT_SEC,
            )
        except (OSError, subprocess.SubprocessError):
            return ""
        return result.stdout.strip()

    cursor = query(["xdotool", "getmouselocation", "--shell"])
    window = query(["xdotool", "getactivewindow"])
    if not WINDOW_ID_RE.fullmatch(window or ""):
        window = ""
    title = query(["xdotool", "getwindowname", window]) if window else ""
    try:
        image = subprocess.run(
            ["import", "-define", "png:compression-level=3", "-window", "root", "png:-"],
            env=env, capture_output=True, stdin=subprocess.DEVNULL, timeout=CAPTURE_TIMEOUT_SEC,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError("screen capture failed") from error
    if image.returncode:
        raise RuntimeError("screen capture failed")
    width, height = png_size(image.stdout)
    mime, picture = encode_picture(image.stdout)
    fields = dict(line.split("=", 1) for line in cursor.splitlines() if "=" in line)
    observation = {
        "image": base64.b64encode(picture).decode("ascii"),
        "mimeType": mime,
        "width": width,
        "height": height,
    }
    try:
        observation["cursor"] = {"x": int(fields["X"]), "y": int(fields["Y"])}
    except (KeyError, ValueError):
        pass
    if window:
        observation["activeWindow"] = {"id": window, **({"title": title} if title else {})}
    return observation


def _int_field(body, key, default, low, high):
    value = body.get(key, default)
    if isinstance(value, bool) or not isinstance(value, int):
        raise RequestError(f"{key} must be an integer")
    return max(low, min(value, high))


def plan_steps(body, settings):
    """Validate the whole request before any step runs, so a bad step runs nothing."""
    display = body.get("display", settings.default_display)
    if not valid_display(display):
        raise RequestError("invalid display")
    steps = body.get("steps", [])
    if not isinstance(steps, list) or len(steps) > MAX_STEPS:
        raise RequestError("invalid steps")
    planned = []
    for step in steps:
        if not isinstance(step, dict):
            raise RequestError("invalid step")
        if "waitMs" in step:
            planned.append(("wait", _int_field(step, "waitMs", 0, 0, 5000)))
            continue
        argv = step.get("argv")
        if not allowed_control_argv(argv, display, settings.launchers):
            raise RequestError("unsupported computer action")
        planned.append(("argv", argv))
    settle_ms = _int_field(body, "settleMs", 0, 0, 5000)
    observe = bool(body.get("observe", True))
    return display, planned, settle_ms, observe


def run_desktop(settings, body):
    display, planned, settle_ms, observe = plan_steps(body, settings)
    with display_lock(display):
        for kind, value in planned:
            if kind == "wait":
                time.sleep(value / 1000)
            else:
                run_control_argv(value, display, settings)
        if settle_ms:
            time.sleep(settle_ms / 1000)
        response = {"completed": len(planned)}
        if observe:
            response["observation"] = capture(display)
    return response


def run_screenshot(settings, body):
    display = body.get("display", settings.default_display)
    if not valid_display(display):
        raise RequestError("invalid display")
    with display_lock(display):
        return {"observation": capture(display)}


def run_mcp_call(hub, body):
    server = body.get("server")
    tool = body.get("tool")
    if not isinstance(server, str) or not isinstance(tool, str):
        raise RequestError("server and tool must be strings")
    try:
        return hub.call(server, tool, body.get("arguments", {}))
    except mcp_hub.InvalidRequest as error:
        raise RequestError(str(error)) from None


def run_mcp_config(hub, body):
    try:
        return hub.replace_user_servers(body.get("servers"))
    except mcp_hub.InvalidRequest as error:
        raise RequestError(str(error)) from None


def make_hub(settings):
    return mcp_hub.McpHub(
        display=settings.default_display,
        log_dir=settings.mcp_log_dir,
        config_path=settings.mcp_config,
        legacy_config_path=LEGACY_MCP_CONFIG if RUNS_AS_ROOT and settings.mcp_config == DEFAULT_MCP_CONFIG else None,
        computer_script=os.path.join(os.path.dirname(os.path.abspath(__file__)), "pm-sbx-computer-mcp"),
        run_as=MCP_RUN_AS,
    )


# ---- Background tasks (owned by this daemon, not by a terminal) ---------------------------------------------------
# /v1/task/start|status|tail|stop. A task is an argv list plus a folder, started as the pm user in the work cgroup, in its
# own session, behind a small wrapper that copies the output into a size-capped log and records the exit code. The table
# of tasks lives on disk (DEFAULT_TASK_DIR, private to this daemon's user, checked before every use) so it survives a restart of this daemon. Never a shell: there is no
# command string anywhere in this API. A task is identified by its PID *and* the start time in /proc/<pid>/stat, so a PID
# the kernel handed out again is never mistaken for the task, and never signalled.
TASK_RUN_AS = "pm"
TASK_ID_RE = re.compile(r"t-[0-9a-f]{8}")
MAX_RUNNING_TASKS = 4
MAX_TASK_ENTRIES = 20  # finished ones beyond this are forgotten (oldest first), logs and all
TASK_LOG_CAP = 4 * 1024 * 1024  # a log never grows past this: older output is dropped, the newest is kept
TASK_LOG_KEEP = 1024 * 1024  # what is kept when the cap is hit
TASK_TAIL_DEFAULT = 16 * 1024
TASK_TAIL_MAX = 64 * 1024
TASK_STOP_GRACE_SEC = 3.0
TASK_LIST_ARG_CHARS = 200
TASK_PATH = "/home/pm/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Runs as `python -I -c <this> LOG_FD EXIT_FD CAP KEEP ARGV...` (the fds are inherited from the daemon: the child needs no
# path into the daemon's folder). It is not a shell: ARGV goes to subprocess.Popen as it is. It copies the output into the log
# (rotating in place, newest kept), and writes {"code": n} to the exit file when the command ends (n < 0: killed by that
# signal). Its own TERM/INT/HUP only wake it: the command gets the same signal from the group kill and the wrapper
# waits for it, so the exit code is still written. A SIGKILL of the group leaves no exit file; the daemon reads that as stopped
# or interrupted, never as finished. A handler (not SIG_IGN) is used so the command does not inherit an ignored signal.
TASK_WRAPPER_SRC = r'''
import json, os, signal, subprocess, sys, threading

MARKER = b"[... earlier output dropped ...]\n"


def main(args):
    log_fd, exit_fd, cap, keep = (int(x) for x in args[:4])
    argv = args[4:]
    for name in ("SIGTERM", "SIGINT", "SIGHUP"):
        if hasattr(signal, name):
            signal.signal(getattr(signal, name), lambda *_: None)
    state = {"off": 0}

    def put(data):
        view = memoryview(data)
        while view:
            if state["off"] >= cap:  # full: keep the newest `keep` bytes behind a marker, in place
                os.lseek(log_fd, max(0, state["off"] - keep), 0)
                kept = os.read(log_fd, keep)
                os.ftruncate(log_fd, 0)
                os.lseek(log_fd, 0, 0)
                os.write(log_fd, MARKER + kept)
                state["off"] = len(MARKER) + len(kept)
            os.lseek(log_fd, state["off"], 0)
            n = os.write(log_fd, view[: cap - state["off"]])
            view = view[n:]
            state["off"] += n

    def finish(code):
        os.lseek(exit_fd, 0, 0)
        os.ftruncate(exit_fd, 0)
        os.write(exit_fd, json.dumps({"code": code}).encode("ascii"))
        try:
            os.fsync(exit_fd)
        except OSError:
            pass

    try:
        child = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    except OSError as error:
        put(("could not start: %s\n" % (error.strerror or error)).encode("utf-8", "replace"))
        finish(126 if isinstance(error, PermissionError) else 127)
        return 0
    out = child.stdout.fileno()

    def pump():
        while True:
            try:
                chunk = os.read(out, 65536)
            except OSError:
                return
            if not chunk:
                return
            put(chunk)

    # A thread, not a blocking loop: a background grandchild may keep the pipe open after the command itself has ended.
    reader = threading.Thread(target=pump, daemon=True)
    reader.start()
    code = child.wait()
    reader.join(1.0)  # whatever the command printed is in the pipe by now; a pipe held open by a grandchild is not waited for
    finish(code)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
'''


def proc_start_ticks(pid):
    """Start time of `pid` in clock ticks since boot (field 22 of /proc/<pid>/stat), or None when it is gone.

    The process name in field 2 may hold spaces and parentheses, so the fields are counted from the LAST ')'.
    A zombie counts as gone."""
    try:
        with open(f"/proc/{int(pid)}/stat", "rb") as handle:
            raw = handle.read().decode("utf-8", "replace")
        fields = raw[raw.rindex(")") + 2:].split()
        if fields[0] in ("Z", "X"):
            return None
        return int(fields[19])
    except (OSError, ValueError, IndexError):
        return None


def current_boot_id():
    try:
        with open("/proc/sys/kernel/random/boot_id", encoding="ascii") as handle:
            return handle.read().strip()
    except OSError:
        return ""


def _task_env(run_as_ids, display):
    """The environment of a task: built from scratch, never the daemon's own (that holds the token file path)."""
    home = "/home/pm"
    if run_as_ids is None:
        home = os.environ.get("HOME", home)
    env = {
        "PATH": TASK_PATH,
        "HOME": home,
        "USER": TASK_RUN_AS,
        "LOGNAME": TASK_RUN_AS,
        "LANG": "C.UTF-8",
        "DISPLAY": display,
    }
    env.update(CHILD_ENV_PINS)
    return env


def validate_task_start(body):
    """(argv, cwd, label) of a start request. Only an argv list and a folder: any other key is refused, so a
    `command` string can never slip in."""
    extra = set(body) - {"argv", "cwd", "label"}
    if extra:
        raise RequestError("start takes argv, cwd and label only")
    argv = body.get("argv")
    if not isinstance(argv, list) or not (1 <= len(argv) <= MAX_ARGV):
        raise RequestError(f"argv must be a list of 1 to {MAX_ARGV} strings")
    for value in argv:
        if not isinstance(value, str) or len(value) > MAX_ARG_LEN or "\0" in value:
            raise RequestError("argv must hold plain strings")
    if argv[0] == "":
        raise RequestError("argv[0] must be a program")
    cwd = body.get("cwd")
    if not isinstance(cwd, str) or not cwd.startswith("/") or "\0" in cwd or len(cwd) > 1024 or ".." in cwd.split("/"):
        raise RequestError("cwd must be an absolute folder path")
    label = body.get("label", "")
    if not isinstance(label, str):
        raise RequestError("label must be text")
    label = CONTROL_CHARS_RE.sub(" ", label).strip()[:80]
    return list(argv), cwd, label


TASKS_OFF = "background tasks are off: the task folder is not safe"
# Every path below the task folder is reached through a directory fd with O_NOFOLLOW where the platform has it (Linux, the
# real sandbox). Elsewhere (Windows unit tests) the plain path is used; the folder checks still run.
HAVE_DIR_FD = bool(getattr(os, "O_NOFOLLOW", 0)) and os.open in os.supports_dir_fd and os.mkdir in os.supports_dir_fd
_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
_BINARY = getattr(os, "O_BINARY", 0)
_CLOEXEC = getattr(os, "O_CLOEXEC", 0)


class TaskDirUnsafe(RuntimeError):
    """The task folder is a link, belongs to someone else, or sits under a folder others can write."""

    def __init__(self, why=""):
        super().__init__(TASKS_OFF)
        self.why = why


def _o(ref, name, flags, mode=0o600):
    fd, path = ref
    if fd >= 0:
        return os.open(name, flags | _NOFOLLOW | _CLOEXEC, mode, dir_fd=fd)
    return os.open(os.path.join(path, name), flags | _BINARY, mode)


def _mkdir_at(ref, name):
    fd, path = ref
    if fd >= 0:
        os.mkdir(name, 0o700, dir_fd=fd)
    else:
        os.mkdir(os.path.join(path, name), 0o700)


def _unlink_at(ref, name):
    fd, path = ref
    if fd >= 0:
        os.unlink(name, dir_fd=fd)
    else:
        os.unlink(os.path.join(path, name))


def _rmdir_at(ref, name):
    fd, path = ref
    if fd >= 0:
        os.rmdir(name, dir_fd=fd)
    else:
        os.rmdir(os.path.join(path, name))


def _open_sub(ref, name):
    """A (fd, path) reference to the sub-folder `name`; never follows a link. The caller closes the fd when it is >= 0."""
    fd, path = ref
    if fd >= 0:
        return os.open(name, os.O_RDONLY | os.O_DIRECTORY | _NOFOLLOW | _CLOEXEC, dir_fd=fd), os.path.join(path, name)
    sub = os.path.join(path, name)
    if os.path.islink(sub) or not os.path.isdir(sub):
        raise OSError("not a plain folder")
    return -1, sub


def _close_ref(ref):
    if ref[0] >= 0:
        os.close(ref[0])


def _check_owner_mode(info, why):
    if os.name != "posix":
        return
    if info.st_uid != os.geteuid():
        raise TaskDirUnsafe(f"{why} belongs to uid {info.st_uid}")
    if info.st_mode & 0o077:
        raise TaskDirUnsafe(f"{why} is open to group or others")


def _check_ancestors(path):
    """Every folder above `path` is root's (or ours) and cannot be written by group or others (a sticky folder like /tmp
    is fine: others cannot rename or delete what is not theirs). Only on POSIX."""
    if os.name != "posix":
        return
    current = os.path.realpath(os.path.dirname(os.path.abspath(path)))
    while True:
        info = os.stat(current)
        if info.st_uid not in (0, os.geteuid()):
            raise TaskDirUnsafe(f"{current} belongs to uid {info.st_uid}")
        if info.st_mode & 0o022 and not info.st_mode & stat_module.S_ISVTX:
            raise TaskDirUnsafe(f"{current} can be written by others")
        up = os.path.dirname(current)
        if up == current:
            return
        current = up


class TaskManager:
    """The task table and its processes. Thread safe. `spawn`, `ticks`, `killpg` and `now` are replaceable for tests."""

    def __init__(self, base_dir, run_as=TASK_RUN_AS, display=DEFAULT_DISPLAY, spawn=None, ticks=None, killpg=None,
                 now=None, boot_id=None, max_running=MAX_RUNNING_TASKS, grace=TASK_STOP_GRACE_SEC, python=None):
        self._dir = base_dir
        self._ids = mcp_hub._pm_ids(run_as)
        self._display = display
        self._spawn = spawn or self._real_spawn
        self._ticks = ticks or proc_start_ticks
        self._killpg = killpg or (lambda pid, sig: os.killpg(pid, sig))
        self._now = now or time.time
        self._boot = current_boot_id() if boot_id is None else boot_id
        self._max_running = max_running
        self._grace = grace
        self._python = python or sys.executable
        self._lock = threading.RLock()
        self._tasks = None  # id -> record, loaded on first use
        self._dfd = -1  # the checked task folder, open only while a request runs
        self._depth = 0

    # -- the task folder: checked on every request, then used only through its directory fd
    def _check_dir(self):
        """Creates the folder when missing (mode 0700) and proves it is safe; returns its fd (-1 where fds are not used)."""
        try:
            _check_ancestors(self._dir)
            try:
                before = os.lstat(self._dir)
            except FileNotFoundError:
                os.makedirs(os.path.dirname(os.path.abspath(self._dir)), mode=0o755, exist_ok=True)
                _check_ancestors(self._dir)
                os.mkdir(self._dir, 0o700)
                before = os.lstat(self._dir)
            if not stat_module.S_ISDIR(before.st_mode):
                raise TaskDirUnsafe("the task folder is a link or not a folder")
            _check_owner_mode(before, "the task folder")
            if not HAVE_DIR_FD:
                return -1
            fd = os.open(self._dir, os.O_RDONLY | os.O_DIRECTORY | _NOFOLLOW | _CLOEXEC)
            try:
                info = os.fstat(fd)
                if (info.st_dev, info.st_ino) != (before.st_dev, before.st_ino):
                    raise TaskDirUnsafe("the task folder was swapped")
                _check_owner_mode(info, "the task folder")
            except BaseException:
                os.close(fd)
                raise
            return fd
        except TaskDirUnsafe:
            raise
        except OSError as error:
            raise TaskDirUnsafe(str(error)) from None

    @contextlib.contextmanager
    def _session(self):
        with self._lock:
            if self._depth:
                self._depth += 1
                try:
                    yield
                finally:
                    self._depth -= 1
                return
            self._dfd = self._check_dir()
            self._depth = 1
            try:
                yield
            finally:
                self._depth = 0
                fd, self._dfd = self._dfd, -1
                if fd >= 0:
                    os.close(fd)

    def _ref(self):
        return (self._dfd, self._dir)

    # -- table on disk
    def _load(self):
        if self._tasks is not None:
            return
        self._tasks = {}
        try:
            fd = _o(self._ref(), "tasks.json", os.O_RDONLY)
            with os.fdopen(fd, "r", encoding="utf-8") as handle:
                data = json.load(handle)
            rows = data.get("tasks") if isinstance(data, dict) else None
            for row in rows if isinstance(rows, list) else []:
                if isinstance(row, dict) and isinstance(row.get("id"), str) and TASK_ID_RE.fullmatch(row["id"]):
                    self._tasks[row["id"]] = row
        except (OSError, ValueError):
            pass

    def _save(self):
        ref = self._ref()
        try:
            _unlink_at(ref, "tasks.json.tmp")  # unlink never follows a link
        except OSError:
            pass
        fd = _o(ref, "tasks.json.tmp", os.O_WRONLY | os.O_CREAT | os.O_EXCL)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump({"version": 1, "tasks": list(self._tasks.values())}, handle, separators=(",", ":"))
        if ref[0] >= 0:
            os.replace("tasks.json.tmp", "tasks.json", src_dir_fd=ref[0], dst_dir_fd=ref[0])
        else:
            os.replace(os.path.join(self._dir, "tasks.json.tmp"), os.path.join(self._dir, "tasks.json"))

    # -- reading files the task can write: never follow a link, only plain files
    def _read_plain(self, task_id, name, limit, tail=False):
        try:
            run = _open_sub(self._ref(), task_id)
        except OSError:
            return None, 0
        try:
            fd = _o(run, name, os.O_RDONLY | getattr(os, "O_NONBLOCK", 0))
        except OSError:
            return None, 0
        finally:
            _close_ref(run)
        try:
            info = os.fstat(fd)
            if not stat_module.S_ISREG(info.st_mode):
                return None, 0
            size = info.st_size
            start = max(0, size - limit) if tail else 0
            os.lseek(fd, start, 0)
            return os.read(fd, min(limit, size - start)), size
        except OSError:
            return None, 0
        finally:
            os.close(fd)

    def _alive(self, rec):
        ticks = rec.get("ticks")
        return rec.get("boot") == self._boot and ticks is not None and self._ticks(rec["pid"]) == ticks

    def _exit_code(self, task_id):
        data, _ = self._read_plain(task_id, "exit", 256)
        if not data:
            return None
        try:
            code = json.loads(data.decode("ascii", "replace")).get("code")
        except (ValueError, AttributeError):
            return None
        return code if isinstance(code, int) and not isinstance(code, bool) else None

    def _refresh(self, rec):
        """Moves a running record to its final state when its process is gone. True when it changed."""
        if rec.get("state") != "running" or self._alive(rec):
            return False
        code = self._exit_code(rec["id"])
        if rec.get("stopRequested"):
            rec["state"] = "stopped"
        elif code is not None:
            rec["state"] = "finished"
        else:
            rec["state"] = "interrupted"  # gone with no exit file: killed or lost, never reported as finished
        if code is not None:
            rec["exitCode"] = code
        rec["ended"] = int(self._now())
        return True

    def recover(self):
        """Called once when the daemon starts."""
        try:
            with self._session():
                self._load()
                changed = False
                for rec in self._tasks.values():
                    changed = self._refresh(rec) or changed
                if changed:
                    self._save()
        except TaskDirUnsafe as error:
            print(f"pm-sbx-control: {TASKS_OFF} ({error.why})", file=sys.stderr)

    def _running(self):
        return [rec for rec in self._tasks.values() if rec.get("state") == "running"]

    # -- requests
    def start(self, body):
        argv, cwd, label = validate_task_start(body)
        with self._session():
            self._load()
            for rec in list(self._tasks.values()):
                self._refresh(rec)
            if len(self._running()) >= self._max_running:
                raise RequestError(f"{self._max_running} tasks are already running; stop one first")
            self._forget_old()
            ref = self._ref()
            while True:
                task_id = "t-" + os.urandom(4).hex()
                if task_id in self._tasks:
                    continue
                try:
                    _mkdir_at(ref, task_id)  # fails when the name exists, even as a planted link
                except FileExistsError:
                    continue
                except OSError as error:
                    raise RuntimeError(f"could not start the task: {error.strerror or error}") from None
                break
            try:
                run = _open_sub(ref, task_id)
            except OSError:
                self._remove_files(task_id)
                raise RuntimeError(TASKS_OFF) from None
            log_fd = exit_fd = -1
            try:
                log_fd = self._make_file(run, "log")
                exit_fd = self._make_file(run, "exit")
                proc = self._spawn(argv, cwd, _task_env(self._ids, self._display), log_fd, exit_fd)
            except (OSError, ValueError) as error:
                for fd in (log_fd, exit_fd):
                    if fd >= 0:
                        os.close(fd)
                _close_ref(run)
                self._remove_files(task_id)
                raise RuntimeError(f"could not start the task: {getattr(error, 'strerror', None) or error}") from None
            os.close(log_fd)
            os.close(exit_fd)
            _close_ref(run)
            rec = {
                "id": task_id, "label": label, "argv": argv, "cwd": cwd, "state": "running", "pid": proc.pid,
                "ticks": self._ticks(proc.pid), "boot": self._boot, "started": int(self._now()),
            }
            self._tasks[task_id] = rec
            self._refresh(rec)  # an instant failure is already over
            self._save()
            return {"task": self._view(rec)}

    def _make_file(self, run, name):
        fd = _o(run, name, os.O_RDWR | os.O_CREAT | os.O_EXCL, 0o600)
        if self._ids is not None:
            os.fchown(fd, self._ids[0], self._ids[1])
        return fd

    def _real_spawn(self, argv, cwd, env, log_fd, exit_fd):
        kwargs = {} if self._ids is None else {"user": self._ids[0], "group": self._ids[1], "extra_groups": []}
        command = [self._python, "-I", "-c", TASK_WRAPPER_SRC, str(log_fd), str(exit_fd), str(TASK_LOG_CAP),
                   str(TASK_LOG_KEEP), *argv]
        proc = subprocess.Popen(
            command, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            pass_fds=(log_fd, exit_fd), start_new_session=True, **kwargs,
        )
        threading.Thread(target=proc.wait, daemon=True).start()  # reaps it, so it never lingers as a zombie
        return proc

    def _remove_files(self, task_id):
        ref = self._ref()
        try:
            run = _open_sub(ref, task_id)
        except OSError:
            run = None
        if run is not None:
            for name in ("log", "exit"):
                try:
                    _unlink_at(run, name)
                except OSError:
                    pass
            _close_ref(run)
        try:
            _rmdir_at(ref, task_id)
        except OSError:
            pass

    def _forget_old(self):
        done = sorted((r for r in self._tasks.values() if r.get("state") != "running"), key=lambda r: r.get("started", 0))
        while len(self._tasks) >= MAX_TASK_ENTRIES and done:
            old = done.pop(0)
            self._remove_files(old["id"])
            del self._tasks[old["id"]]

    def _view(self, rec, brief=False):
        argv = [a[:TASK_LIST_ARG_CHARS] for a in rec["argv"]]
        view = {"id": rec["id"], "state": rec["state"], "argv": argv, "cwd": rec["cwd"], "started": rec["started"]}
        if rec.get("label"):
            view["label"] = rec["label"]
        for key in ("exitCode", "ended"):
            if key in rec:
                view[key] = rec[key]
        if not brief:
            _, size = self._read_plain(rec["id"], "log", 0)
            view["logBytes"] = size
        return view

    def _get(self, body):
        task_id = body.get("id")
        if not isinstance(task_id, str) or not TASK_ID_RE.fullmatch(task_id):
            raise RequestError("invalid task id")
        self._load()
        rec = self._tasks.get(task_id)
        if rec is None:
            raise RequestError("no such task")
        return rec

    def status(self, body):
        with self._session():
            self._load()
            if "id" not in body:
                changed = False
                for rec in self._tasks.values():
                    changed = self._refresh(rec) or changed
                if changed:
                    self._save()
                rows = sorted(self._tasks.values(), key=lambda r: r.get("started", 0))
                return {"tasks": [self._view(r, brief=True) for r in rows], "maxRunning": self._max_running}
            rec = self._get(body)
            if self._refresh(rec):
                self._save()
            return {"task": self._view(rec)}

    def tail(self, body):
        size = _int_field(body, "bytes", TASK_TAIL_DEFAULT, 1, TASK_TAIL_MAX)
        with self._session():
            rec = self._get(body)
            if self._refresh(rec):
                self._save()
            data, total = self._read_plain(rec["id"], "log", size, tail=True)
            view = self._view(rec, brief=True)
        view["logBytes"] = total
        view["text"] = (data or b"").decode("utf-8", "replace")
        view["cutStart"] = total > len(data or b"")
        return {"task": view}

    def stop(self, body):
        with self._session():
            rec = self._get(body)
            if self._refresh(rec):
                self._save()
            if rec["state"] == "running":
                rec["stopRequested"] = True
                self._save()
                self._signal(rec, signal.SIGTERM)
                deadline = time.monotonic() + self._grace
                while self._alive(rec) and time.monotonic() < deadline:
                    time.sleep(0.05)
                if self._alive(rec):
                    self._signal(rec, getattr(signal, "SIGKILL", signal.SIGTERM))
                    for _ in range(40):
                        if not self._alive(rec):
                            break
                        time.sleep(0.05)
                self._refresh(rec)
                self._save()
            return {"task": self._view(rec)}

    def _signal(self, rec, sig):
        # Checked right before the signal: a PID that is not this task's process any more is never touched.
        if not self._alive(rec):
            return
        try:
            self._killpg(rec["pid"], sig)
        except (OSError, ProcessLookupError):
            pass


# ---- Lend an app (mirror into the sandbox screen) ----------------------------------------------------------------
# The host pushes frames of a Windows app and pulls input events; a loopback viewer page (shown by pm-sbx-lend-view in a
# Chrome --app window on the sandbox desktop) draws the frame and turns mouse and keys into events. Memory only.
# Scroll events carry dy in wheel notches (positive = down).
LEND_FRAME_BODY_BYTES = 4 * 1024 * 1024
LEND_MAX_EVENTS = 200
LEND_MAX_FRAME_BYTES = 3 * 1024 * 1024
LEND_MAX_DIM = 16_384
LEND_POLL_SEC = 10
LEND_MAX_WAIT_MS = 2000  # the longest /v1/lend/events may be held waiting for an event
LEND_ID_RE = re.compile(r"[a-z0-9-]{1,32}")
LEND_KEYS = frozenset(
    ("enter", "tab", "escape", "backspace", "delete", "up", "down", "left", "right", "pageup", "pagedown", "home", "end")
)
LEND_MAX_TEXT = 1000
CONTROL_CHARS_RE = re.compile("[\x00-\x1f\x7f-\x9f  ]")


def lend_valid_id(value):
    return isinstance(value, str) and LEND_ID_RE.fullmatch(value) is not None


def lend_clean_title(value):
    text = CONTROL_CHARS_RE.sub("", value) if isinstance(value, str) else ""
    text = text.strip()[:80]
    return text or "App"


def lend_clean_event(event):
    """A validated copy of one viewer event, or None."""
    if not isinstance(event, dict):
        return None

    def num(key):
        value = event.get(key)
        if isinstance(value, bool) or not isinstance(value, (int, float)) or value != value or abs(value) > LEND_MAX_DIM * 4:
            return None
        return int(value)

    kind = event.get("t")
    if kind == "click":
        x, y = num("x"), num("y")
        button, count = event.get("button", "left"), event.get("count", 1)
        if x is None or y is None or button not in ("left", "right") or isinstance(count, bool) or count not in (1, 2):
            return None
        return {"t": "click", "x": x, "y": y, "button": button, "count": count}
    if kind == "dblclick":
        # The second click of a double click (the first one went out as a "click"): the host sends only DBLCLK + button up.
        x, y = num("x"), num("y")
        if x is None or y is None:
            return None
        return {"t": "dblclick", "x": x, "y": y}
    if kind == "text":
        text = event.get("s")
        if not isinstance(text, str) or not text or len(text) > LEND_MAX_TEXT:
            return None
        return {"t": "text", "s": text}
    if kind == "key":
        return {"t": "key", "k": event["k"]} if event.get("k") in LEND_KEYS else None
    if kind == "scroll":
        x, y, dy = num("x"), num("y"), num("dy")
        if x is None or y is None or dy is None:
            return None
        return {"t": "scroll", "x": x, "y": y, "dy": dy}
    return None


def launch_lend_view(settings, lend_id, title, w=1024, h=768):
    """Start the viewer window for one lent app. Returns the process (None if it could not start)."""
    try:
        return subprocess.Popen(
            [settings.lend_view, lend_id, title],
            env={**child_env(settings.default_display), "PM_SBX_LEND_PORT": str(settings.lend_port),
                 "PM_SBX_LEND_WINDOW_SIZE": f"{max(100, min(w, 1600))},{max(100, min(h, 1000))}"},
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
        )
    except OSError:
        return None


class LendHub:
    """Frames, queued events and viewer processes per lent app id. Thread safe."""

    def __init__(self, launcher):
        self._launcher = launcher  # (id, title, w, h) -> process-like (poll/terminate) or None
        self._cond = threading.Condition()
        self._apps = {}  # id -> {"title", "proc", "frame": None | (seq, w, h, bytes), "events": [...]}

    def open(self, lend_id, title, w=1024, h=768):
        with self._cond:
            app = self._apps.get(lend_id)
            if app is not None and app["proc"] is not None and app["proc"].poll() is None:
                return
        proc = self._launcher(lend_id, title, w, h)
        with self._cond:
            app = self._apps.setdefault(lend_id, {"title": title, "proc": None, "frame": None, "events": []})
            app["title"], app["proc"] = title, proc
        if proc is None:
            raise RuntimeError("could not start the viewer")

    def close(self, lend_id):
        with self._cond:
            app = self._apps.pop(lend_id, None)
            self._cond.notify_all()
        if app is not None and app["proc"] is not None:
            try:
                app["proc"].terminate()
            except OSError:
                pass

    def close_all(self):
        with self._cond:
            ids = list(self._apps)
        for lend_id in ids:
            self.close(lend_id)

    def title(self, lend_id):
        with self._cond:
            app = self._apps.get(lend_id)
            return app["title"] if app else None

    def put_frame(self, lend_id, seq, w, h, jpeg, captured_ms=0, sent_ms=0):
        with self._cond:
            app = self._apps.get(lend_id)
            if app is None:
                raise RequestError("app is not open")
            if app["frame"] is None or seq >= app["frame"][0]:
                app["frame"] = (seq, w, h, jpeg)
                app["captured_ms"] = captured_ms  # when the host captured it (unix ms), so the viewer can log the age
                app["sent_ms"] = sent_ms  # when the host sent it (unix ms; raw frames only, else 0)
                self._cond.notify_all()

    def captured_ms(self, lend_id):
        with self._cond:
            app = self._apps.get(lend_id)
            return app.get("captured_ms", 0) if app else 0

    def sent_ms(self, lend_id):
        with self._cond:
            app = self._apps.get(lend_id)
            return app.get("sent_ms", 0) if app else 0

    def wait_frame(self, lend_id, after, timeout):
        """The latest frame with seq > after, or None on timeout / unknown id."""
        deadline = time.monotonic() + timeout
        with self._cond:
            while True:
                app = self._apps.get(lend_id)
                if app is None:
                    return None
                frame = app["frame"]
                if frame is not None and frame[0] > after:
                    return frame
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return None
                self._cond.wait(remaining)

    def push_event(self, lend_id, event):
        with self._cond:
            app = self._apps.get(lend_id)
            if app is None:
                return False
            app["events"].append(event)
            del app["events"][:-LEND_MAX_EVENTS]
            self._cond.notify_all()  # a host long-polling /v1/lend/events answers at once
            return True

    def drain(self, lend_id, wait=0.0):
        """The queued events. With `wait` seconds, holds until one arrives (or the app closes, or the time is up)."""
        deadline = time.monotonic() + wait
        with self._cond:
            while True:
                app = self._apps.get(lend_id)
                if app is None:
                    return []
                if app["events"]:
                    events, app["events"] = app["events"], []
                    return events
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return []
                self._cond.wait(remaining)


def _lend_id(body):
    lend_id = body.get("id")
    if not lend_valid_id(lend_id):
        raise RequestError("invalid id")
    return lend_id


def lend_open(lend, body):
    lend_id = _lend_id(body)
    w = _int_field(body, "w", 1024, 1, LEND_MAX_DIM)
    h = _int_field(body, "h", 768, 1, LEND_MAX_DIM)
    lend.open(lend_id, lend_clean_title(body.get("title")), w, h)
    return {"ok": True}


def lend_close(lend, body):
    lend.close(_lend_id(body))
    return {"ok": True}


def lend_frame(lend, body):
    lend_id = _lend_id(body)
    seq = _int_field(body, "seq", 0, 0, 2**53)
    w = _int_field(body, "w", 0, 1, LEND_MAX_DIM)
    h = _int_field(body, "h", 0, 1, LEND_MAX_DIM)
    encoded = body.get("jpeg_b64")
    if not isinstance(encoded, str) or len(encoded) > LEND_MAX_FRAME_BYTES * 4 // 3 + 8:
        raise RequestError("invalid frame")
    try:
        jpeg = base64.b64decode(encoded, validate=True)
    except ValueError:
        raise RequestError("invalid frame") from None
    if not jpeg.startswith(JPEG_SOI) or len(jpeg) > LEND_MAX_FRAME_BYTES:
        raise RequestError("invalid frame")
    lend.put_frame(lend_id, seq, w, h, jpeg, _int_field(body, "ts", 0, 0, 2**53))
    return {"ok": True}


def _header_int(headers, name, default, low, high):
    raw = headers.get(name)
    if raw is None:
        return _int_field({}, name, default, low, high)
    try:
        value = int(raw.strip())
    except ValueError:
        raise RequestError(f"{name} must be an integer") from None
    return max(low, min(value, high))


def lend_frame_raw(lend, headers, jpeg):
    """The raw twin of lend_frame: the body is the JPEG itself, the rest is in X- headers."""
    lend_id = headers.get("X-Lend-Id")
    if not lend_valid_id(lend_id):
        raise RequestError("invalid id")
    seq = _header_int(headers, "X-Seq", 0, 0, 2**53)
    w = _header_int(headers, "X-W", 0, 1, LEND_MAX_DIM)
    h = _header_int(headers, "X-H", 0, 1, LEND_MAX_DIM)
    if headers.get("X-W") is None or headers.get("X-H") is None:
        raise RequestError("invalid frame")
    sent = _header_int(headers, "X-Sent-Ms", 0, 0, 2**53)
    if not jpeg.startswith(JPEG_SOI) or len(jpeg) > LEND_MAX_FRAME_BYTES:
        raise RequestError("invalid frame")
    lend.put_frame(lend_id, seq, w, h, jpeg, sent, sent)
    return {"ok": True}


def lend_events(lend, body):
    wait_ms = _int_field(body, "wait_ms", 0, 0, LEND_MAX_WAIT_MS)
    return {"events": lend.drain(_lend_id(body), wait_ms / 1000.0)}


