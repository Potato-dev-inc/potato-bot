def lend_page(title, lend_id):
    def js(value):
        return json.dumps(value).replace("<", "\\u003c").replace(">", "\\u003e").replace("&", "\\u0026")

    safe = title.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    page = LEND_PAGE.replace("__TITLE_JSON__", js(title)).replace("__ID__", js(lend_id)).replace("__TITLE__", safe)
    return page.encode("utf-8")


LEND_PATH_RE = re.compile(r"/lend/([a-z0-9-]{1,32})(/frame|/input)?")


def make_viewer_handler(lend):
    class ViewerHandler(BaseHTTPRequestHandler):
        server_version = "pm-sbx-lend"
        sys_version = ""

        def log_message(self, *_args):
            pass

        def _send(self, status, body=b"", content_type="text/plain", headers=()):
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            for name, value in headers:
                self.send_header(name, value)
            self.end_headers()
            try:
                self.wfile.write(body)
            except OSError:
                pass

        def _match(self):
            path, _, query = self.path.partition("?")
            match = LEND_PATH_RE.fullmatch(path)
            return (match.group(1), match.group(2) or "", query) if match else (None, "", "")

        def do_GET(self):
            lend_id, tail, query = self._match()
            if lend_id is None or tail == "/input":
                return self._send(404)
            if tail == "":
                title = lend.title(lend_id)
                if title is None:
                    return self._send(404)
                return self._send(200, lend_page(title, lend_id), "text/html; charset=utf-8")
            after = -1
            for part in query.split("&"):
                if part.startswith("after="):
                    try:
                        after = int(part[6:])
                    except ValueError:
                        after = -1
            frame = lend.wait_frame(lend_id, after, LEND_POLL_SEC)
            if frame is None:
                return self._send(204)
            seq, w, h, jpeg = frame
            self._send(200, jpeg, "image/jpeg", (("X-Seq", str(seq)), ("X-W", str(w)), ("X-H", str(h)), ("X-Captured", str(lend.captured_ms(lend_id))), ("X-Sent-Ms", str(lend.sent_ms(lend_id)))))

        def do_POST(self):
            lend_id, tail, _ = self._match()
            if lend_id is None or tail != "/input":
                return self._send(404)
            try:
                length = int(self.headers.get("Content-Length", "0"))
                if length < 0 or length > MAX_BODY_BYTES:
                    return self._send(400)
                event = lend_clean_event(json.loads(self.rfile.read(length)))
            except ValueError:
                return self._send(400)
            if event is None:
                return self._send(400)
            self._send(200 if lend.push_event(lend_id, event) else 404)

    return ViewerHandler


class ViewerServer(ThreadingHTTPServer):
    daemon_threads = True


def make_handler(settings, hub=None, lend=None, tasks=None):
    hub = make_hub(settings) if hub is None else hub
    lend = LendHub(lambda i, t, w, h: launch_lend_view(settings, i, t, w, h)) if lend is None else lend
    tasks = TaskManager(settings.task_dir, display=settings.default_display) if tasks is None else tasks
    get_routes = {"/v1/mcp/tools": lambda body: hub.snapshot()}
    post_routes = {
        "/v1/desktop": lambda body: run_desktop(settings, body),
        "/v1/screenshot": lambda body: run_screenshot(settings, body),
        "/v1/mcp/call": lambda body: run_mcp_call(hub, body),
        "/v1/lend/open": lambda body: lend_open(lend, body),
        "/v1/lend/close": lambda body: lend_close(lend, body),
        "/v1/lend/frame": lambda body: lend_frame(lend, body),
        "/v1/lend/events": lambda body: lend_events(lend, body),
        "/v1/task/start": lambda body: tasks.start(body),
        "/v1/task/status": lambda body: tasks.status(body),
        "/v1/task/tail": lambda body: tasks.tail(body),
        "/v1/task/stop": lambda body: tasks.stop(body),
    }
    put_routes = {"/v1/mcp/config": lambda body: run_mcp_config(hub, body)}
    raw_routes = {"/v1/lend/frame-raw": lambda headers, data: lend_frame_raw(lend, headers, data)}

    class ControlHandler(BaseHTTPRequestHandler):
        server_version = "pm-sbx-control"
        sys_version = ""

        def log_message(self, *_args):
            pass

        def do_GET(self):
            self._handle(get_routes, read_body=False)

        def do_POST(self):
            self._handle(post_routes, read_body=True, raw_routes=raw_routes)

        def do_PUT(self):
            self._handle(put_routes, read_body=True)

        def _handle(self, routes, read_body, raw_routes=None):
            if not authorized(self.headers.get("Authorization", ""), settings.token):
                self._send_json(401, {"error": "unauthorized"})
                return
            raw_route = (raw_routes or {}).get(self.path)
            if raw_route is not None:
                try:
                    response = raw_route(self.headers, self._read_raw(LEND_FRAME_BODY_BYTES))
                except RequestError as error:
                    self._send_json(400, {"error": str(error)})
                    return
                except Exception:
                    self._send_json(500, {"error": "internal error"})
                    return
                self._send_json(200, response)
                return
            route = routes.get(self.path)
            if route is None:
                self._send_json(404, {"error": "not found"})
                return
            try:
                response = route(self._read_json(self._body_limit()) if read_body else {})
            except RequestError as error:
                self._send_json(400, {"error": str(error)})
                return
            except RuntimeError as error:
                self._send_json(500, {"error": str(error)})
                return
            except Exception:
                self._send_json(500, {"error": "internal error"})
                return
            self._send_json(200, response)

        def _body_limit(self):
            return LEND_FRAME_BODY_BYTES if self.path == "/v1/lend/frame" else MAX_BODY_BYTES

        def _read_raw(self, limit):
            try:
                length = int(self.headers.get("Content-Length", "0"))
            except ValueError:
                raise RequestError("invalid content length") from None
            if length < 0 or length > limit:
                raise RequestError("request body too large")
            return self.rfile.read(length)

        def _read_json(self, limit=MAX_BODY_BYTES):
            try:
                length = int(self.headers.get("Content-Length", "0"))
            except ValueError:
                raise RequestError("invalid content length") from None
            if length < 0 or length > limit:
                raise RequestError("request body too large")
            try:
                body = json.loads(self.rfile.read(length))
            except ValueError:
                raise RequestError("invalid json") from None
            if not isinstance(body, dict):
                raise RequestError("request body must be a JSON object")
            return body

        def _send_json(self, status, payload):
            encoded = json.dumps(payload, separators=(",", ":")).encode("utf-8")
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(encoded)))
            self.end_headers()
            try:
                self.wfile.write(encoded)
            except OSError:
                pass

    return ControlHandler


def load_settings(env):
    default_focus = os.path.join(os.path.dirname(os.path.abspath(__file__)), FOCUS_OR_LAUNCH)
    default_display = env.get("PM_SBX_DISPLAY", DEFAULT_DISPLAY)
    if not valid_display(default_display):
        raise ConfigError("PM_SBX_DISPLAY must look like :99")
    return Settings(
        token=read_token_file(env.get("PM_SBX_CONTROL_TOKEN_FILE", "")),
        port=parse_port(env.get("PM_SBX_CONTROL_PORT", str(DEFAULT_PORT))),
        default_display=default_display,
        launchers=load_launchers(env.get("PM_SBX_LAUNCHERS_FILE", "")),
        focus_wrapper=env.get("PM_SBX_FOCUS_OR_LAUNCH", default_focus),
        mcp_config=env.get("PM_SBX_MCP_CONFIG", DEFAULT_MCP_CONFIG),
        mcp_log_dir=env.get("PM_SBX_MCP_LOG_DIR", DEFAULT_MCP_LOG_DIR),
        lend_view=env.get("PM_SBX_LEND_VIEW", LEND_VIEW_BIN),
        lend_port=parse_port(env.get("PM_SBX_LEND_PORT", str(LEND_VIEW_PORT))),
        task_dir=env.get("PM_SBX_TASK_DIR", DEFAULT_TASK_DIR),
    )


def main(env=None):
    try:
        settings = load_settings(os.environ if env is None else env)
    except ConfigError as error:
        print(f"pm-sbx-control: {error}", file=sys.stderr)
        return 2
    hub = make_hub(settings)
    signal.signal(signal.SIGTERM, lambda _signo, _frame: sys.exit(0))
    hub.start()
    lend = LendHub(lambda i, t, w, h: launch_lend_view(settings, i, t, w, h))
    tasks = TaskManager(settings.task_dir, display=settings.default_display)
    tasks.recover()  # a task whose process is gone with no exit file becomes "interrupted", never "finished"
    server = ThreadingHTTPServer((BIND_HOST, settings.port), make_handler(settings, hub, lend, tasks))
    viewer = ViewerServer((BIND_HOST, settings.lend_port), make_viewer_handler(lend))
    threading.Thread(target=viewer.serve_forever, daemon=True).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
        viewer.shutdown()
        viewer.server_close()
        lend.close_all()
        hub.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
