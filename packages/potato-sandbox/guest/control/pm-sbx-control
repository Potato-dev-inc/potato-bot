MAX_STEPS = 64
MIN_TOKEN_LEN = 16
CONTROL_TIMEOUT_SEC = 10
CAPTURE_TIMEOUT_SEC = 10
# The focus wrapper bounds each wmctrl call at 5 s and may also wait out a browser
# forward. Wait for it to exit so a slow listing is not reported as success.
BROWSER_OPEN_POLL_SEC = 2.4
FOCUS_COMPLETION_SEC = 5 + BROWSER_OPEN_POLL_SEC + 5 + 1
FOCUS_OR_LAUNCH = "pm-sbx-focus-or-launch"
PROFILE_PREFIX = "PM_SBX_BROWSER_PROFILE="
