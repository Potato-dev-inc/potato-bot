#!/usr/bin/python3 -I
# Puppet Master: the root process that owns the MCP servers which hold secrets. Written for this repo (no upstream code).
"""Started by the Windows host with `wsl -u root --exec python3 -I /usr/local/sbin/pm-sbx-secret-hub` and spoken to over
that process's stdin and stdout, one JSON object per line. Nothing else reaches it: it opens no port and no socket, it
has no file the desktop user can write to, and nobody runs it through sudo (there is no sudo rule). The bot, which is
user pm, cannot call the servers it holds; only the host can, after its own card gate.

Requests (each has "id"):
  {"op":"config","servers":[{"name","command","args","env"}]}   replace the servers (the env values arrive here, once)
  {"op":"tools"}                                                -> {"servers":[{"name","status","error","tools"}]}
  {"op":"call","server","tool","arguments"}                     -> {"content":[...],"isError":bool}
  {"op":"ping"}
Every reply is {"id","ok":true,...} or {"id","ok":false,"error","status"}. No reply ever carries an env value.

Each server runs as its own numeric uid (60000-63999) with its own 0700 home, a passwd entry written here (some
programs, Node among them, look their user up), and a log pm cannot open. A server's /proc/<pid>/environ and memory are
unreadable to every other user, so the bot's terminal cannot read a token out of it.

When stdin closes (the host went away, the sandbox stopped) or a stop signal comes, every server is stopped and this process
exits. At start it first kills any server a hub that was killed hard left behind.
"""

import importlib.machinery
import importlib.util
import json
import os
import re
import signal
import sys
import threading
import zlib

HERE = os.path.dirname(os.path.abspath(__file__))
HOME_ROOT = "/var/lib/pm-sbx-sec"
LOG_DIR = "/var/log/pm-sbx/mcp-sec"
UID_BASE = 60000
UID_SPAN = 4000
NAME_RE = re.compile(r"[a-z0-9_-]{1,32}")
MAX_REQUEST_BYTES = 4 * 1024 * 1024


def _load_hub():
    for path in (os.path.join(HERE, "pm-sbx-mcp-hub"), "/usr/local/bin/pm-sbx-mcp-hub"):
        if os.path.exists(path):
            loader = importlib.machinery.SourceFileLoader("pm_sbx_mcp_hub", path)
            spec = importlib.util.spec_from_loader("pm_sbx_mcp_hub", loader)
            module = importlib.util.module_from_spec(spec)
            loader.exec_module(module)
            return module
    raise SystemExit("pm-sbx-secret-hub: pm-sbx-mcp-hub not found")


def uid_for(name):
    """A uid per server name in a range no real user has: one server cannot read another's /proc."""
    return UID_BASE + zlib.crc32(name.encode("ascii")) % UID_SPAN


def home_of(name, home_root=HOME_ROOT):
    return home_root.rstrip("/") + "/" + name


def ensure_passwd(name, passwd="/etc/passwd", group="/etc/group", home_root=HOME_ROOT):
    """Writes a passwd and group line for the server's uid once (a program that looks its user up then finds one)."""
    uid = uid_for(name)
    user = "pmsec%d" % uid
    for path, line in (
        (passwd, "%s:x:%d:%d:pm secret server:%s:/usr/sbin/nologin\n" % (user, uid, uid, home_of(name, home_root))),
        (group, "%s:x:%d:\n" % (user, uid)),
    ):
        try:
            with open(path, encoding="utf-8") as handle:
                text = handle.read()
        except OSError:
            continue
        if any(row.split(":")[2:3] == [str(uid)] for row in text.splitlines()):
            continue
        fd = os.open(path, os.O_WRONLY | os.O_APPEND)
        try:
            os.write(fd, line.encode("utf-8"))
        finally:
            os.close(fd)


def prepare(name, home_root=HOME_ROOT, log_dir=LOG_DIR, passwd="/etc/passwd", group="/etc/group"):
    """The server's home (0700, its own), tmp, and the folder only root can open for its log."""
    uid = uid_for(name)
    os.makedirs(home_root, mode=0o711, exist_ok=True)
    os.makedirs(log_dir, mode=0o700, exist_ok=True)
    os.chmod(log_dir, 0o700)
    home = home_of(name, home_root)
    for folder in (home, os.path.join(home, "tmp")):
        os.makedirs(folder, mode=0o700, exist_ok=True)
        os.chown(folder, uid, uid)
        os.chmod(folder, 0o700)
    ensure_passwd(name, passwd, group, home_root)


def reap_stale(proc="/proc"):
    """Kills any process of our uid range: servers a hub that died hard left running. Returns how many."""
    killed = 0
    try:
        entries = os.listdir(proc)
    except OSError:
        return 0
    for entry in entries:
        if not entry.isdigit() or int(entry) == os.getpid():
            continue
        try:
            with open(os.path.join(proc, entry, "status"), encoding="ascii") as handle:
                real = [line.split()[1] for line in handle if line.startswith("Uid:")]
            if real and UID_BASE <= int(real[0]) < UID_BASE + UID_SPAN:
                os.kill(int(entry), signal.SIGKILL)
                killed += 1
        except (OSError, ValueError, IndexError):
            continue
    return killed


class Session:
    """Handles requests for one hub. `drop` is False only in tests on a machine where the uid drop cannot happen."""

    def __init__(self, hub_module, log_dir=LOG_DIR, drop=True, prepare_fn=None, **hub_args):
        self.mod = hub_module
        self.drop = drop
        self.prepare = prepare_fn or (prepare if drop else (lambda name: None))
        identity = (lambda name: ((uid_for(name), uid_for(name)), home_of(name))) if drop else None
        self.hub = hub_module.McpHub(display="", log_dir=log_dir, config_path=os.devnull, computer_script="", identity=identity,
                                     **hub_args)

    def handle(self, request):
        """One request object -> one reply object."""
        rid = request.get("id") if isinstance(request, dict) else None
        try:
            if not isinstance(request, dict):
                raise self.mod.InvalidRequest("a request is an object")
            op = request.get("op")
            if op == "config":
                specs = self.mod.validate_servers(request.get("servers"))
                for spec in specs:
                    self.prepare(spec.name)
                self.hub._install(specs)
                return {"id": rid, "ok": True, "servers": self.tools()}
            if op == "tools":
                return {"id": rid, "ok": True, "servers": self.tools()}
            if op == "call":
                if request.get("server") == self.mod.COMPUTER_NAME:
                    raise self.mod.InvalidRequest("unknown server")
                result = self.hub.call(request.get("server"), request.get("tool"), request.get("arguments", {}))
                return {"id": rid, "ok": True, **result}
            if op == "ping":
                return {"id": rid, "ok": True}
            raise self.mod.InvalidRequest("unknown op")
        except self.mod.InvalidRequest as error:
            return {"id": rid, "ok": False, "status": 400, "error": str(error)}
        except self.mod.ServerUnavailable as error:
            return {"id": rid, "ok": False, "status": 500, "error": str(error)}
        except Exception:  # noqa: BLE001 - one bad request never ends the hub, and never echoes a value
            return {"id": rid, "ok": False, "status": 500, "error": "the secret hub could not do that"}

    def tools(self):
        return [entry for entry in self.hub.snapshot()["servers"] if entry["name"] != self.mod.COMPUTER_NAME]

    def close(self):
        self.hub.close()


def serve(session, stdin, stdout):
    """Reads request lines until stdin closes. Replies are written one per line."""
    lock = threading.Lock()
    while True:
        line = stdin.readline(MAX_REQUEST_BYTES + 1)
        if not line:
            return
        if len(line) > MAX_REQUEST_BYTES:
            reply = {"id": None, "ok": False, "status": 400, "error": "request too large"}
        else:
            try:
                request = json.loads(line)
            except ValueError:
                reply = {"id": None, "ok": False, "status": 400, "error": "not JSON"}
            else:
                reply = session.handle(request)
        data = (json.dumps(reply, separators=(",", ":")) + "\n").encode("utf-8")
        with lock:
            stdout.write(data)
            stdout.flush()


def main():
    if getattr(os, "geteuid", lambda: -1)() != 0:
        print("pm-sbx-secret-hub: must run as root", file=sys.stderr)
        return 77
    reap_stale()
    session = Session(_load_hub())
    stop = threading.Event()

    def on_signal(_signum, _frame):
        stop.set()
        session.close()
        os._exit(0)

    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, on_signal)
    try:
        serve(session, sys.stdin.buffer, sys.stdout.buffer)
    finally:
        session.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
