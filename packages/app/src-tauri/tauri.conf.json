{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Potato Bot",
  "version": "1.0.10",
  "identifier": "com.puppetmaster.app",
  "build": {
    "beforeDevCommand": "node ../../scripts/vite-dev.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app"
    ],
    "resources": [
      "resources/potato-brain/*",
      "resources/potato-brain/persona/*",
      "resources/potato-brain/persona/packs/**/*",
      "resources/potato-sandbox/**/*",
      "resources/legal/**/*",
      "resources/node/*",
      "resources/bin/*",
      "resources/phone/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      },
      "wix": {
        "language": "en-US",
        "fragmentPaths": ["wix/phone-cleanup.wxs"],
        "componentGroupRefs": ["PhoneCleanupGroup"],
        "upgradeCode": "dc12578b-d2a4-5c61-9748-3725742afc51"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1RTkyOTExNzlBOURFQTIKUldTaTNxbDVFU25wcGN5VEd6ajMrcUpzMlpiaVdHeVhMczdrcUltd0JUVzI1WmZVWjBzUXhCakgK",
      "endpoints": [
        "https://github.com/Potato-dev-inc/potato-bot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
