{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Potato Bot",
  "version": "1.0.2",
  "identifier": "com.puppetmaster.app",
  "build": {
    "beforeDevCommand": "node ../../scripts/vite-dev.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "app"
    ],
    "resources": [
      "resources/potato-brain/*",
      "resources/potato-brain/persona/*",
      "resources/potato-brain/persona/packs/**/*",
      "resources/potato-sandbox/**/*",
      "resources/legal/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
